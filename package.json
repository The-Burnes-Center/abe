{
  "name": "abe",
  "version": "1.0.0",
  "bin": {
    "abe": "bin/abe.js"
  },
  "scripts": {
    "brand:sync": "ts-node --prefer-ts-exts scripts/sync-brand.ts",
    "prebuild": "ts-node --prefer-ts-exts scripts/sync-brand.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:lambda": "vitest run",
    "synth": "ts-node --prefer-ts-exts scripts/sync-brand.ts && cdk synth",
    "deploy": "ts-node --prefer-ts-exts scripts/sync-brand.ts && cdk deploy",
    "cdk": "cdk"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.1144.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21"
  },
  "overrides": {
    "fast-xml-parser": "^4.5.5",
    "fast-uri": "^3.1.2",
    "form-data": "^4.0.4",
    "axios": "^1.13.5",
    "lodash": "^4.18.0",
    "node-forge": "^1.4.0",
    "image-size": "^1.2.1",
    "follow-redirects": "^1.16.0",
    "minimatch": "^3.1.4",
    "picomatch": "^2.3.2",
    "brace-expansion": "^1.1.13",
    "braces": "^3.0.3",
    "yaml": "^1.10.3",
    "js-yaml": "^3.14.2",
    "rollup": "^4.59.0",
    "immutable": "^4.3.8",
    "flatted": "^3.4.2",
    "@babel/runtime": "^7.26.10",
    "esbuild": "^0.25.0",
    "@smithy/config-resolver": "^4.4.0",
    "postcss": "^8.5.10",
    "uuid": "^14.0.0"
  }
}
