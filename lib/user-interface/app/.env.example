# Local development config for `npm run dev`.
# Copy to .env (git-ignored) and fill in from your deployed stack's outputs:
#   aws cloudformation describe-stacks --stack-name <STACK_NAME> --query "Stacks[0].Outputs"
# The dev server turns these into /aws-exports.json (same shape CDK deploys).

# Region the stack is deployed in, e.g. us-east-1
ABE_REGION=

# Outputs "UserPool ID" and "UserPool Client ID"
ABE_USER_POOL_ID=
ABE_USER_POOL_CLIENT_ID=

# Output "HTTP-API - apiEndpoint", e.g. https://abc123.execute-api.us-east-1.amazonaws.com
ABE_HTTP_ENDPOINT=

# Output "WS-API - apiEndpoint" plus the stage name /prod, e.g. wss://def456.execute-api.us-east-1.amazonaws.com/prod
ABE_WS_ENDPOINT=

# Match the deployment: true only if allowedSignupDomains is set for the stack
ABE_SELF_SIGNUP_ENABLED=false

# false if the stack was deployed with enableEval=false
ABE_EVAL_ENABLED=true
